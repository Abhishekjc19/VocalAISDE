# nhost — Update these for production or use Vercel environment variables
# For LOCAL development: use localhost values below
# For PRODUCTION (Vercel): set these in Vercel dashboard
NEXT_PUBLIC_NHOST_SUBDOMAIN=wswbfudwrzygkeyjsofk
NEXT_PUBLIC_NHOST_REGION=ap-south-1
NEXT_PUBLIC_NHOST_AUTH_URL=https://wswbfudwrzygkeyjsofk.auth.ap-south-1.nhost.run/v1/auth
NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://wswbfudwrzygkeyjsofk.graphql.ap-south-1.nhost.run/v1
NEXT_PUBLIC_NHOST_STORAGE_URL=https://wswbfudwrzygkeyjsofk.storage.ap-south-1.nhost.run/v1/storage
NEXT_PUBLIC_NHOST_FUNCTIONS_URL=https://wswbfudwrzygkeyjsofk.functions.ap-south-1.nhost.run/v1
NEXT_PUBLIC_HASURA_ADMIN_SECRET=nhost-admin-secret

# LLM API — Get a free key at https://console.groq.com
# Leave empty for stubbed LLM calls with realistic delay
GROQ_API_KEY=

# Webhook trigger secret
WEBHOOK_SECRET=agent-flow-webhook-secret-2024
